# Local artefacts only — nothing in this repo should leak machine state.
.DS_Store
*.log
*.swp
.idea/
.vscode/

# Skill runtime outputs (default locations live in /tmp, not the repo, but
# guard against accidental cwd-relative writes):
codex-vision-out/
*.tmux-log

# Session-continuation cache written by run_codex after each invocation.
# Machine-specific UUIDs — do not commit.
.last-session-uuid

# Stress-test reports (timestamped per run, no need to track them).
tests/session-modes/results-*.md
